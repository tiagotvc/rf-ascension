# Postgres real (VPS, Neon, Vercel Postgres...) — de preferência uma
# connection string com pooler, já que funções serverless podem escalar
# em paralelo. Sem isso, qualquer página do fórum/admin falha com erro
# explícito em vez de mostrar dado falso.
DATABASE_URL=postgres://usuario:senha@host:5432/echelon

# Chave usada para assinar o cookie de sessão da equipe (HMAC). Gere uma
# string aleatória longa, ex.: `openssl rand -base64 32`.
SESSION_SECRET=

# Senha de login da equipe em /admin/entrar. Trocar por uma senha forte
# antes de ir pra produção — nunca comitar o valor real aqui.
ADMIN_PASSWORD=

# API do AccountBridge (ver RF-Online/AccountBridge no repo do servidor)
# rodando na VPS, do lado do banco real de conta do jogo. Sem isso, não
# dá pra criar/verificar conta de jogador (login com conta do jogo).
GAME_ACCOUNT_BRIDGE_URL=https://sua-vps:porta
GAME_ACCOUNT_BRIDGE_KEY=
